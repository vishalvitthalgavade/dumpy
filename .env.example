# Copy this file to .env.local and fill in real values.
# Never commit .env.local or paste real credentials into this example file.

# Postgres connection string (e.g. from Neon, Supabase, or Vercel Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password required to log into /admin. Choose a long, unique value.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Random secret used to sign admin session cookies and hash analytics data.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
